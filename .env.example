# Copy to .env and fill in
GEMINI_API_KEY=your-key-from-aistudio.google.com

# The only folder JARVIS may read or write
JARVIS_WORKSPACE=C:/Users/you/Projects

# gemini-flash-latest always points at the current flash model,
# so it won't break when Google retires a version number.
GEMINI_MODEL=gemini-flash-latest
JARVIS_WAKE=hey jarvis,jarvis,jervis
JARVIS_LANG=en-IN
JARVIS_VOICE_RATE=185

# true hides the automation browser (faster for reading pages),
# false shows it so you can watch what JARVIS is doing.
JARVIS_BROWSER_HEADLESS=false

# Job search. Adzuna is the one source that covers Indian listings; a free
# developer key takes two minutes at https://developer.adzuna.com
# Without it JARVIS still searches Remotive and Arbeitnow.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Where to look, for the boards that can filter by place.
JARVIS_JOB_GEO=india
JARVIS_JOB_CITY=Bangalore

# How JARVIS sounds. The neural voices need edge-tts installed and a network
# connection; without either it falls back to the local Windows voice.
# Say "what voice are you using" to see the full list.
JARVIS_VOICE=en-IN-PrabhatNeural
JARVIS_VOICE_SPEED=+8%
JARVIS_VOICE_PITCH=+0Hz
JARVIS_NEURAL_VOICE=true

# Listening. Say "list microphones" to see the numbers, "recalibrate mic"
# to re-learn the room. Raise JARVIS_PAUSE if it cuts you off mid-sentence.
JARVIS_MIC=
JARVIS_PAUSE=1.0
JARVIS_MIC_SENSITIVITY=
JARVIS_SHOW_HEARD=true
JARVIS_WAKE_FUZZY=0.72
